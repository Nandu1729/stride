{
  "info": {
    "_postman_id": "f3e07d5b-9b0c-4e7d-a1ab-stride-collection",
    "name": "Stride API",
    "description": "Stride backend endpoints for the Ethara AI Round 1 task. Set the base_url and run Sign up first; the test script copies the JWT into a collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:4000" },
    { "key": "token", "value": "" },
    { "key": "project_id", "value": "" },
    { "key": "task_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth — Sign up",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/auth/signup",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Aanya Mehta\",\n  \"email\": \"aanya@stride.app\",\n  \"password\": \"DemoPass123!\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (data && data.token) pm.collectionVariables.set('token', data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth — Log in",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo@stride.app\",\n  \"password\": \"DemoPass123!\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (data && data.token) pm.collectionVariables.set('token', data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth — Me",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/auth/me"
      }
    },
    {
      "name": "Projects — list",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/projects"
      }
    },
    {
      "name": "Projects — create",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/projects",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Q3 launch\",\n  \"description\": \"Ship v1 to first 50 small teams.\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (data && data.project) pm.collectionVariables.set('project_id', data.project.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Projects — detail",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/projects/{{project_id}}"
      }
    },
    {
      "name": "Projects — invite member",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/projects/{{project_id}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"rohan@stride.app\",\n  \"role\": \"MEMBER\"\n}"
        }
      }
    },
    {
      "name": "Tasks — list",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/projects/{{project_id}}/tasks"
      }
    },
    {
      "name": "Tasks — create",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/projects/{{project_id}}/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Wire auth API to the SPA\",\n  \"description\": \"Use TanStack Query, persist token via httpOnly cookie.\",\n  \"status\": \"IN_PROGRESS\",\n  \"priority\": \"HIGH\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (data && data.task) pm.collectionVariables.set('task_id', data.task.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Tasks — change status",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/tasks/{{task_id}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"DONE\"\n}"
        }
      }
    },
    {
      "name": "Tasks — comment",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/tasks/{{task_id}}/comments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"body\": \"Looks good — shipping after one more review.\"\n}"
        }
      }
    },
    {
      "name": "Dashboard",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/projects/{{project_id}}/dashboard"
      }
    },
    {
      "name": "Health — healthz",
      "request": { "method": "GET", "url": "{{base_url}}/api/healthz" }
    },
    {
      "name": "Health — readyz",
      "request": { "method": "GET", "url": "{{base_url}}/api/readyz" }
    }
  ]
}
