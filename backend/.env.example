# Stride backend environment

# Postgres in production. Use file:./prisma/dev.db for local SQLite.
DATABASE_URL="postgresql://user:password@localhost:5432/stride?schema=public"

# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Auth
JWT_SECRET="change-me-min-32-chars-please-change-this-now"
JWT_EXPIRES_IN="7d"
COOKIE_SECURE=false
COOKIE_DOMAIN=

# CORS
CORS_ORIGIN="http://localhost:5173"

# When set, the backend serves the built web app from this directory in production.
WEB_DIST_DIR=
