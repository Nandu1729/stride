# Stride — single-service environment
# Copy to .env (or set in Railway) and adjust values.

# Postgres connection. On Railway, the Postgres plugin sets DATABASE_URL automatically.
DATABASE_URL="postgresql://user:password@localhost:5432/stride?schema=public"

# HTTP server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Auth — generate a long random secret for production.
JWT_SECRET="change-me-min-32-chars-please-change-this-now"
JWT_EXPIRES_IN="7d"

# Cookies
COOKIE_SECURE=false
COOKIE_DOMAIN=

# CORS — comma-separated list of allowed origins.
CORS_ORIGIN="http://localhost:5173"

# When set, the backend serves the built web bundle from this directory in production.
# The Railway buildCommand copies web/dist to backend/dist/web.
WEB_DIST_DIR=
