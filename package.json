{
  "name": "stride",
  "version": "0.1.0",
  "private": true,
  "description": "Team task manager: projects, members, tasks, board.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "backend",
    "web"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:web",
    "dev:backend": "npm --workspace backend run dev",
    "dev:web": "npm --workspace web run dev",
    "build": "npm-run-all build:web build:backend",
    "build:web": "npm --workspace web run build",
    "build:backend": "npm --workspace backend run build",
    "start": "node backend/dist/index.js",
    "test": "npm-run-all test:backend test:web",
    "test:backend": "npm --workspace backend run test",
    "test:web": "npm --workspace web run test",
    "lint": "npm-run-all lint:backend lint:web",
    "lint:backend": "npm --workspace backend run lint",
    "lint:web": "npm --workspace web run lint",
    "typecheck": "npm-run-all typecheck:backend typecheck:web",
    "typecheck:backend": "npm --workspace backend run typecheck",
    "typecheck:web": "npm --workspace web run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml}\" --ignore-path .gitignore",
    "db:migrate": "npm --workspace backend run db:migrate",
    "db:seed": "npm --workspace backend run db:seed",
    "submit:check": "node scripts/submit-check.mjs"
  },
  "devDependencies": {
    "npm-run-all": "4.1.5",
    "prettier": "3.3.3",
    "typescript": "5.5.4"
  }
}
